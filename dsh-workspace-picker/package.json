{
  "name": "dsh-workspace-picker",
  "version": "0.1.0",
  "description": "工作区目录选择：Windows 上优先调用系统文件夹选择器（可直接切换盘符），失败时回退官方浏览式选择器",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "dsh-plugin-marketplace",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
