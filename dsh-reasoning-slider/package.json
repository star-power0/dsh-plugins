{
  "name": "dsh-reasoning-slider",
  "version": "0.1.0",
  "description": "5档思考强度滑块：自动给自定义模型注入 reasoningEfforts（牢梁/梁子/梁白开/梁圣/梁神）+ 带动画滑块的模型选择器",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lightningcss": "^1.29.0",
    "pngjs": "^7.0.0",
    "jpeg-js": "^0.4.4"
  }
}